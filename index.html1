<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>DIAMONS LEGION</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
<style>
:root{--hero-image:url("imagen-legion.jpg");--bg-main:#080603;--bg-card:#171006;--text-main:#fff8e7;--text-muted:#c6b58e;--primary-neon:#ffd45a;--accent-neon:#a86b08;--border-color:#9a6b16;--neon-glow:0 0 18px #e5a92388;--neon-glow-strong:0 0 12px #ffcf4d,0 0 30px #ffb30099}
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,sans-serif}
html,body{min-height:100vh;background:#080603;color:var(--text-main);display:flex;flex-direction:column;background-image:radial-gradient(circle at 50% 12%,#a66a252b,transparent 58%),radial-gradient(circle at 85% 85%,#f2b52a18,transparent 50%)}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:9998;border:3px solid transparent;border-image:linear-gradient(90deg,#5b3908,#fff0a6,#b8790c,#fff4b0,#5b3908) 1;animation:edgeGlow 3s linear infinite}
body:after{content:"";position:fixed;inset:0;pointer-events:none;z-index:9997;background:linear-gradient(110deg,transparent 0%,#fff6c522 48%,transparent 52%);background-size:220% 100%;animation:ledRun 5s linear infinite;opacity:.55}
@keyframes ledRun{to{background-position:-220% 0}}@keyframes edgeGlow{50%{filter:brightness(1.8) drop-shadow(0 0 7px #ffc83d)}}
#notification-toast{position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-200px);background:#171006;color:#ffe08a;border:2px solid #ffd45a;padding:.9rem 1.5rem;border-radius:14px;font-weight:900;font-size:.85rem;box-shadow:var(--neon-glow-strong);transition:transform .4s;z-index:999999;width:90%;max-width:380px;text-align:center}
#notification-toast.show{transform:translateX(-50%) translateY(0)}
.auth-wrapper{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;width:100%}
.auth-container{max-width:390px;width:100%;background:linear-gradient(145deg,#211707,#0b0804);border:2px solid var(--primary-neon);border-radius:24px;padding:2.2rem 1.8rem;box-shadow:var(--neon-glow-strong);position:relative}
.brand-header{text-align:center;margin-bottom:24px}.brand-header h1{font-family:Orbitron,sans-serif;font-size:22px;font-weight:900;color:white;letter-spacing:2px;text-shadow:0 0 15px #ffcf4d}.brand-header h1 span,.nav-brand-title span{color:var(--primary-neon)}
.auth-tabs{display:flex;gap:6px;margin-bottom:20px;background:#080603;border-radius:12px;padding:4px;border:1.5px solid var(--border-color)}
.auth-tab{flex:1;text-align:center;padding:.7rem;font-weight:bold;font-size:.82rem;cursor:pointer;border-radius:10px;color:var(--text-muted);background:transparent;border:0}
.auth-tab.active,.pay-tab-btn.active{background:linear-gradient(135deg,#fff0a6,#d89a20,#8c5708);color:#1a1003;box-shadow:var(--neon-glow);font-weight:900}
.form-group{margin-bottom:1.2rem;position:relative}.form-group label{display:block;font-size:.78rem;color:var(--text-muted);margin-bottom:.4rem;font-weight:800;letter-spacing:.5px}
.form-control{width:100%;background:#080603;border:1.5px solid var(--border-color);padding:.8rem 1rem;border-radius:12px;color:white;font-size:.9rem;outline:0}
.form-control:focus{border-color:var(--primary-neon);box-shadow:var(--neon-glow)}
.btn-main{width:100%;background:linear-gradient(135deg,#fff0a6 0%,#f4c34e 25%,#b87912 60%,#ffe58a 100%);color:#211300;border:1px solid #fff0a6;padding:.95rem;border-radius:14px;font-weight:900;font-size:.95rem;cursor:pointer;transition:.3s;margin-top:.8rem;box-shadow:var(--neon-glow);letter-spacing:.5px;text-transform:uppercase}
.btn-main:hover{filter:brightness(1.15);transform:translateY(-2px);box-shadow:var(--neon-glow-strong)}
.navbar{display:flex;justify-content:space-between;align-items:center;padding:.85rem 1rem;background:#171006;border-bottom:2px solid var(--border-color);position:sticky;top:0;z-index:100;box-shadow:0 6px 25px #000c}
.nav-brand-title{font-family:Orbitron,sans-serif;font-size:.8rem;font-weight:900;color:white;display:flex;align-items:center;gap:6px;text-shadow:0 0 10px #ffcf4d88}
.nav-wallet-pills{display:flex;gap:4px;align-items:center}.wallet-pill-top{background:#080603;border:1.5px solid var(--border-color);padding:5px 7px;border-radius:14px;font-size:.65rem;color:var(--primary-neon);font-weight:900;display:flex;align-items:center;gap:4px;cursor:pointer;box-shadow:var(--neon-glow)}
.container{max-width:500px;width:100%;margin:0 auto;padding:1.2rem;flex:1;display:flex;flex-direction:column;padding-bottom:100px}
.section-title{font-size:.85rem;color:var(--primary-neon);margin:1rem 0 .6rem;font-weight:900;letter-spacing:1.2px;text-transform:uppercase;text-align:center;text-shadow:0 0 10px #ffcf4d88}
.payment-methods-tabs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1.2rem}
.pay-tab-btn{background:#171006;border:1.5px solid var(--border-color);border-radius:14px;padding:.8rem;text-align:center;color:var(--text-muted);font-weight:800;font-size:.82rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px}
.store-banner-img{width:100%;height:320px;border-radius:20px;margin-bottom:1.2rem;background-image:linear-gradient(180deg,#08060308 35%,#080603d9 100%),var(--hero-image);background-size:cover;background-position:center;border:2px solid var(--primary-neon);box-shadow:var(--neon-glow-strong);display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:15px}
.store-banner-text{background:#080603d9;padding:6px 16px;border-radius:12px;border:1px solid var(--primary-neon);text-align:center}.store-banner-text p{font-size:.85rem;color:#fff;font-weight:900;letter-spacing:2px}
.game-banner-card{width:100%;height:180px;border-radius:18px;margin-bottom:1.2rem;background-image:linear-gradient(180deg,#08060322,#080603f2),var(--hero-image);background-size:cover;background-position:center;border:2px solid var(--border-color);box-shadow:0 6px 20px #000b;cursor:pointer;display:flex;flex-direction:column;justify-content:flex-end;padding:14px}
.game-banner-content{display:flex;justify-content:space-between;align-items:center}.game-banner-content h4{font-family:Orbitron,sans-serif;font-size:1rem}.game-banner-btn{background:linear-gradient(135deg,#fff0a6,#c18416);color:#211300;font-size:.75rem;font-weight:900;padding:6px 14px;border-radius:10px;box-shadow:var(--neon-glow)}
.diamonds-grid{display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-bottom:1.2rem}
.diamond-card,.wallet-card-option,.ticket-receipt-card,.wallet-box-detail,.admin-panel-box{background:linear-gradient(145deg,#211707,#0b0804);border:2px solid var(--border-color);border-radius:18px;box-shadow:0 6px 20px #0008}
.diamond-card{padding:.9rem .6rem;text-align:center;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:space-between;min-height:165px;position:relative;overflow:hidden}
.diamond-card:hover,.diamond-card.selected,.wallet-card-option:hover{border-color:var(--primary-neon);box-shadow:var(--neon-glow-strong);transform:translateY(-2px)}
.offer-tag{background:linear-gradient(90deg,#ffe28a,#bd7c0d);color:#1c1100;font-size:.65rem;font-weight:900;padding:3px 14px;border-radius:0 0 10px 10px;text-transform:uppercase;margin-bottom:4px}
.diamond-card-content{display:flex;flex-direction:column;align-items:center;gap:2px}.diamond-card-content h4{font-size:.95rem;font-weight:900;font-family:Orbitron,sans-serif;color:#fff0bd}.diamond-card-content p,.wallet-info p{font-size:.72rem;color:var(--text-muted);font-weight:700}
.diamond-price-badge{background:#080603;border:1.5px solid var(--primary-neon);color:var(--primary-neon);font-weight:900;font-size:.85rem;padding:6px 12px;border-radius:20px;margin-top:6px;width:90%;text-align:center;box-shadow:var(--neon-glow)}
.wallet-card-option{padding:1.2rem;margin-bottom:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:space-between}.wallet-card-left{display:flex;align-items:center;gap:14px}
.usdt-real-icon,.saldo-icon-box{width:45px;height:45px;border-radius:14px;display:flex;align-items:center;justify-content:center}.usdt-real-icon{background:#26A17B}.saldo-icon-box{background:linear-gradient(135deg,#fff0a6,#c18416);color:#211300;font-size:1.2rem}
.wallet-info h4{font-size:.95rem;font-weight:900;margin-bottom:3px}.wallet-box-detail{padding:1.4rem;margin-bottom:1rem;border-color:var(--primary-neon);box-shadow:var(--neon-glow-strong)}
.wallet-address-box{background:#080603;border:1.5px solid var(--border-color);padding:.9rem;border-radius:12px;font-size:.85rem;word-break:break-all;color:var(--primary-neon);font-weight:bold;margin:.6rem 0 1rem;text-align:center}
.ticket-receipt-card{padding:1.2rem;margin-bottom:1.2rem;position:relative;overflow:hidden}.ticket-header-flex{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;border-bottom:1.5px solid var(--border-color);padding-bottom:10px}
.ticket-title-group h4{font-family:Orbitron,sans-serif;font-size:.95rem}.ticket-title-group p{font-size:.68rem;color:var(--text-muted)}
.ticket-status-badge{font-size:.7rem;font-weight:900;padding:4px 10px;border-radius:20px}.status-proceso{background:#ffb70322;color:#ffce57;border:1px solid #ffb70399}.status-aprobado{background:#10b98122;color:#10b981;border:1px solid #10b98199}.status-rechazado{background:#ef444422;color:#ef4444;border:1px solid #ef444499}
.ticket-details-body{font-size:.78rem;display:flex;flex-direction:column;gap:6px}.ticket-row-line{display:flex;justify-content:space-between}.ticket-row-line span:first-child{color:var(--text-muted)}
.admin-panel-box{padding:1.4rem;margin-top:1.5rem;border-style:dashed}.admin-req-card,.user-data-card{background:#080603;border:1px solid var(--border-color);border-radius:12px;padding:1rem;margin-top:10px;font-size:.78rem}
.app-bottom-nav{position:fixed;bottom:0;left:0;width:100%;background:#171006;border-top:2px solid var(--border-color);display:flex;justify-content:space-around;padding:12px 0;z-index:1000;box-shadow:0 -6px 25px #000e}
.nav-item-btn{background:transparent;border:0;color:var(--text-muted);display:flex;flex-direction:column;align-items:center;gap:4px;font-size:10px;text-transform:uppercase;font-weight:900;cursor:pointer;flex:1}
.nav-item-btn i{font-size:18px}.nav-item-btn.active,.nav-item-btn:hover{color:var(--primary-neon);text-shadow:0 0 12px #ffcf4d}
.hidden{display:none!important}
button,.auth-tab,.pay-tab-btn,.diamond-card,.wallet-card-option{transition:all .25s}
@media(max-width:380px){.nav-brand-title{font-size:.66rem}.wallet-pill-top{font-size:.58rem;padding:4px}}
</style>
</head>
<body>
<div id="notification-toast">Notificación</div>
